# Environment Variables & Secrets
.env
.env.*
*.env
*.pem
*.key
*.pfx
secrets/
credentials/

# System & OS Files
.DS_Store
Thumbs.db
Desktop.ini

# IDE & Editor Settings
.vscode/
.idea/
*.swp
*.swo
